{
  "info": {
    "name": "Constructora — Factory Method y Abstract Factory",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Crear cliente primero, después su obra. clientId se toma de cliente_id. Para eliminar un cliente se deben eliminar sus obras antes. Nuevos campos obligatorios en POST y PUT. Puerto 3000."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000"
    },
    {
      "key": "cliente_id",
      "value": ""
    },
    {
      "key": "obra_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Clientes · Factory Method",
      "item": [
        {
          "name": "Crear",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/clientes",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Juan Pérez\",\n  \"detail\": \"juan@example.com\",\n  \"kind\": \"Persona\",\n  \"status\": \"Activo\",\n  \"document\": \"12345678\",\n  \"phone\": \"987654321\",\n  \"address\": \"Av. Perú 123, Lima\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Estado HTTP 201', () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) pm.collectionVariables.set('cliente_id', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/clientes"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Estado HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultar por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/clientes/{{cliente_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Estado HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Actualizar",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/clientes/{{cliente_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Juan Pérez actualizado\",\n  \"detail\": \"juan@example.com\",\n  \"kind\": \"Persona\",\n  \"status\": \"Inactivo\",\n  \"document\": \"12345678\",\n  \"phone\": \"987654321\",\n  \"address\": \"Av. Perú 123, Lima\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Estado HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Buscar",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/clientes?q=Juan"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Estado HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Obras · Abstract Factory",
      "item": [
        {
          "name": "Crear",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
