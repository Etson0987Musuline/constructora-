                ]
              }
            }
          ]
        },
        {
          "name": "Actualizar",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/obras/{{obra_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Edificio Los Olivos actualizado\",\n  \"detail\": \"Lima, Perú\",\n  \"kind\": \"Residencial\",\n  \"status\": \"En ejecución\",\n  \"clientId\": \"{{cliente_id}}\",\n  \"responsible\": \"Ana Torres\",\n  \"startDate\": \"2026-11-05\",\n  \"endDate\": \"2027-05-30\",\n  \"budget\": 150000,\n  \"progress\": 45\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Estado HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Buscar",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/obras?q=Olivos"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Estado HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Eliminar",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{base_url}}/api/obras/{{obra_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Estado HTTP 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Eliminar cliente (después de eliminar sus obras)",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{base_url}}/api/clientes/{{cliente_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Eliminado', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    }
  ]
}