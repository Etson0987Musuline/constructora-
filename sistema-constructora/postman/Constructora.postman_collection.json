            ],
            "url": "{{base_url}}/api/obras",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Edificio Los Olivos\",\n  \"detail\": \"Lima, Perú\",\n  \"kind\": \"Residencial\",\n  \"status\": \"Planificación\",\n  \"clientId\": \"{{cliente_id}}\",\n  \"responsible\": \"Ana Torres\",\n  \"startDate\": \"2026-11-05\",\n  \"endDate\": \"2027-05-30\",\n  \"budget\": 150000,\n  \"progress\": 0\n}",
